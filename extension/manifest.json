{
  "manifest_version": 3,
  "name": "Revisit",
  "version": "0.1.0",
  "description": "Capture or research selected text without leaving the page.",
  "permissions": ["identity", "storage", "contextMenus", "activeTab", "alarms"],
  "host_permissions": ["https://revisit-gqyx.onrender.com/*", "http://127.0.0.1:8000/*"],
  "oauth2": {
    "client_id": "482585759079-dc9micic4sir95i6htbp41vk5suat1hi.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_popup": "popup.html", "default_title": "Save to Revisit"},
  "options_page": "options.html",
  "commands": {
    "capture-selection": {
      "suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"},
      "description": "Capture the current selection"
    }
  }
}
