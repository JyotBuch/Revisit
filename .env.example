# ── Authentication ───────────────────────────────────────────────────────────
# Single-user session-cookie auth. Disabled by default for local development.
# Set AUTH_ENABLED=true (with APP_USERNAME/APP_PASSWORD) before deploying
# to any network-accessible host. This is MVP auth — one account only, no
# OAuth, no teams. See README for details.
AUTH_ENABLED=false
APP_USERNAME=
APP_PASSWORD=

# ── Database ─────────────────────────────────────────────────────────────────
# Required. PostgreSQL connection string (with psycopg2 driver).
# The pgvector extension must be enabled on this database.
DATABASE_URL=postgresql+psycopg2://revisit:revisit@localhost:5432/revisit

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# If set, captures are embedded with text-embedding-3-small and Revisit Cards
# can be generated by an LLM (generation_method=llm).
# If unset: embeddings fall back to a deterministic fake (dev/testing only,
# no semantic meaning) and cards always use rule-based generation.
OPENAI_API_KEY=

# Optional. Chat model used when generation_method=llm is requested.
# Defaults to gpt-4o-mini if unset.
OPENAI_REVISIT_CARD_MODEL=

# ── Resource retrieval (optional) ────────────────────────────────────────────
# Set SEARCH_PROVIDER=tavily and TAVILY_API_KEY=<key> to enable real web
# search for related resources. If either is unset, retrieval falls back to
# a fake local provider (dev/testing only — does not search the web).
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Legacy / generic key slot — checked as a fallback if TAVILY_API_KEY is unset.
# Not required if TAVILY_API_KEY is set.
SEARCH_API_KEY=
